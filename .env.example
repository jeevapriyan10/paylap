# PayLap Configuration Template
# Copy this file to .env and adjust as necessary.

# Mode: 'demo' (FakePayPal provider) or 'live' (PayPal REST API)
PAYLAP_MODE=demo

# Payout mode: 'live' (real PayPal payouts) or 'simulated' (mocked payout step even in live mode)
PAYLAP_PAYOUT_MODE=live

# Public URL of the PayLap instance (used for PayPal return and cancel redirects)
PAYLAP_PUBLIC_URL=http://localhost:8000

# Database Connection URL (SQLite by default)
PAYLAP_DB_URL=sqlite:///./paylap.db

# PayPal REST API Credentials (Required if PAYLAP_MODE=live)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Default test receiver email for payouts in live sandbox
PAYPAL_WORKER_EMAIL=worker-sandbox@example.com

# AI & LLM Arbiter Settings
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Stage 2: Intelligence, Guardrails & Policy
PAYLAP_CAPTURE_STRATEGY=partial
PAYLAP_ARBITER_MODE=auto
PAYLAP_ARBITER_FAIL=closed
PAYLAP_RECEIPT_SECRET=your_receipt_signing_secret_here
PAYLAP_POLICY_MAX_TASK_USD=25
PAYLAP_POLICY_DAILY_USD=100
PAYLAP_POLICY_ALLOWLIST=
ARENA_WORKER_SOURCE=auto
